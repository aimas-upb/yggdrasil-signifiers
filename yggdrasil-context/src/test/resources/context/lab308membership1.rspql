PREFIX consert: <http://pervasive.semanticweb.org/ont/2017/07/consert/core#>
PREFIX cashmere: <https://aimas.cs.pub.ro/ont/cashmere#> 
PREFIX ex: <http://example.org/>

REGISTER RSTREAM <http://localhost:8080/context/domains/lab308Domain/group/testMembership> AS
CONSTRUCT {
  ?agent cashmere:memberIn <http://localhost:8080/context/domains/lab308Domain/group> .
}

FROM NAMED WINDOW <LocatedAt> ON <http://localhost:8080/context/streams/LocatedAt> [RANGE PT10S STEP PT2S]
WHERE
{
  WINDOW <LocatedAt> {
    ?persLocAssertion 
        a ex:LocatedAt;
        consert:assertionSubject ?agent ;
        consert:assertionObject ex:lab308 .
  }
}