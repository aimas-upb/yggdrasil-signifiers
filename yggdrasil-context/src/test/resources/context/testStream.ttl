@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .
@prefix consert: <http://pervasive.semanticweb.org/ont/2017/07/consert/core#> .

# Simple context assertion: Person located at a room
ex:assertion1 rdf:type ex:LocatedAt ;
    consert:hasSubject ex:person1 ;
    consert:hasObject ex:room101 ;
    consert:hasTimestamp "2025-06-06T10:30:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .

# Entities
ex:person1 rdf:type ex:Person .
ex:room101 rdf:type ex:Room .